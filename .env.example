# ─────────────────────────────────────────────────────────────────────
# Adoption & Escalation Risk Analyzer — DEMO build
#
# You do NOT need any of these to run the demo. With no .env at all the
# app boots in demo mode and serves fully synthetic data. Copy this file
# to `.env` only if you want to tweak behaviour.
# ─────────────────────────────────────────────────────────────────────

# Demo mode (synthetic data only). Keep true for the public build.
DEMO_MODE=true

# Risk thresholds (score 0-100)
RISK_THRESHOLD_HIGH=75
RISK_THRESHOLD_MEDIUM=50
LOG_LEVEL=INFO

# Background sync cadence (the scheduler runs but connectors are inert in demo)
SYNC_DB_PATH=data/app.db
SYNC_INTERVAL_HOURS=24
SYNC_ENABLED=true

# Email draft defaults
EMAIL_SENDER_NAME=Technical Account Management

# Optional AI self-heal layer (local Ollama). Off by default unless Ollama
# is reachable; safe to leave as-is for the demo.
AI_HEAL_ENABLED=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:latest

# ─────────────────────────────────────────────────────────────────────
# Advanced / live-mode toggles (NOT used by the demo)
#
# The production tool reads from real systems (Salesforce, monitoring
# portals, a CS platform, an internal knowledge search). Those connectors
# and their auth tooling are intentionally NOT part of this public build.
# Endpoints below are placeholders only.
# ─────────────────────────────────────────────────────────────────────
# SF_LIVE=false
# INSIGHTS_LIVE=false
# CSINSIGHTS_LIVE=false
# PLANHAT_LIVE=false
# ENGAGEMENT_LIVE=false
